# ---------------------------------------------------------------------------
# LegacyLens configuration. Copy to .env and fill in what you need.
# Every AI key is optional. With none set, only local Ollama can answer, and
# all non-AI features (scanning, graph, compare, dashboard) still work.
# ---------------------------------------------------------------------------

# --- Security (required in production) -------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Set to false after creating your account if other people can reach this server.
ALLOW_REGISTRATION=true
# Set to true when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Address the web app listens on. Use 0.0.0.0 only behind HTTPS.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# --- Database --------------------------------------------------------------
POSTGRES_USER=legacylens
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=legacylens
# Only used when running the backend outside Docker.
DATABASE_URL=postgresql+psycopg://legacylens:change-me-db-password@localhost:5433/legacylens

# --- AI providers (free tiers and local models only) -----------------------
# Order in which providers are tried. Allowed values: gemini, groq, ollama.
LLM_PROVIDER_ORDER=gemini,groq,ollama

# Google AI Studio key: https://aistudio.google.com/apikey
# IMPORTANT: use a project with NO billing account linked. Linking billing moves
# the project to a paid tier, and an API client cannot detect or prevent that.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# Local safety budgets. LegacyLens stops calling a model at these limits.
GEMINI_DAILY_REQUEST_BUDGET=200
GEMINI_MINUTE_REQUEST_BUDGET=10

# Groq key: https://console.groq.com/keys
# IMPORTANT: stay on the Free plan. Do not upgrade the organization.
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant
GROQ_DAILY_REQUEST_BUDGET=800
GROQ_MINUTE_REQUEST_BUDGET=25

# Local models, no key and no cost. Start with: docker compose --profile ollama up -d
# Then pull a model: docker compose exec ollama ollama pull qwen2.5-coder:1.5b
# Bigger models answer better but need more memory, for example qwen2.5-coder:7b (about 6 GB).
OLLAMA_MODELS=qwen2.5-coder:1.5b
# Used when the backend runs outside Docker.
OLLAMA_BASE_URL=http://localhost:11434
# Used when the backend runs in Docker. For Ollama on the host machine, set this to
# http://host.docker.internal:11434
OLLAMA_BASE_URL_DOCKER=http://ollama:11434

# --- Embeddings (local, runs on your CPU) ----------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Limits that protect a shared server ----------------------------------
MAX_PROJECTS_PER_USER=50
# Per user. They protect the shared free AI quota from a single account.
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_IMPORTS_PER_HOUR=30
RATE_LIMIT_TEST_RUNS_PER_MINUTE=10
# Address people use to open LegacyLens. Writes from any other site are refused.
CORS_ORIGINS=http://localhost:3000

# --- Search index ------------------------------------------------------------
# Embedding runs on the CPU at roughly 20 to 50 code sections per second. Larger
# projects embed their most important code first and skip tests.
MAX_EMBEDDED_CHUNKS=20000

# --- Sandbox for generated tests -------------------------------------------
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=180
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1.0
